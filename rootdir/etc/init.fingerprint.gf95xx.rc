#
# Goodix fingerprint
#
on fs
    # goodix fingerprint
    chown system system /dev/goodix_fp
    # goodix fingerprint end

service ztecmd /vendor/bin/hw/vendor.zte.fingerprint.ztecmd@1.0-service
   class late_start
   user system
   group system input
   writepid /dev/cpuset/top-app/tasks
   #disabled

# on property:vendor.fingerprint.id=gf95xx
#    start ztecmd
