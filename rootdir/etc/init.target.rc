on early-init
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -a -d /vendor/lib/modules audio_q6_pdr audio_q6_notifier audio_snd_event audio_apr audio_adsp_loader audio_q6 audio_native audio_usf audio_pinctrl_lpi audio_swr audio_platform audio_hdmi audio_stub audio_wcd_core audio_wsa881x audio_wsa883x audio_bolero_cdc audio_wsa_macro audio_va_macro audio_rx_macro audio_tx_macro audio_wcd938x audio_wcd938x_slave audio_wcd937x audio_wcd937x_slave audio_machine_lito
    write /proc/sys/kernel/sched_boost 1

on init
    write /dev/stune/foreground/schedtune.sched_boost_no_override 1
    write /dev/stune/top-app/schedtune.sched_boost_no_override 1
    write /dev/stune/schedtune.colocate 0
    write /dev/stune/background/schedtune.colocate 0
    write /dev/stune/system-background/schedtune.colocate 0
    write /dev/stune/foreground/schedtune.colocate 0
    write /dev/stune/top-app/schedtune.colocate 1
    #Moving to init as this is needed for qseecomd
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    start vendor.qseecomd
    start keymaster-4-0

on early-fs
    start vold

on fs
    start hwservicemanager
    mount_all --early
    chown root system /mnt/vendor/persist
    chmod 0771 /mnt/vendor/persist
    restorecon_recursive /mnt/vendor/persist
    restorecon_recursive /mnt/vendor/persist/sensors
    restorecon_recursive /mnt/vendor/persist/data
    mkdir /mnt/vendor/persist/data 0700 system system

on post-fs
    # set RLIMIT_MEMLOCK to 64MB
    setrlimit 8 67108864 67108864

on late-fs
    wait_for_prop hwservicemanager.ready true
    exec_start wait_for_keymaster
    mount_all --late

on post-fs-data
    mkdir /vendor/data/tombstones 0771 system system

    mkdir /data/vendor/goodix 0770 system system
    mkdir /mnt/vendor/persist/fingerprint 0770 system system

#on early-boot
#   start vendor.sensors

on boot
    write /dev/cpuset/audio-app/cpus 1-2
    # Add a cpuset for the camera daemon
    # We want all cores for camera
    mkdir /dev/cpuset/camera-daemon
    write /dev/cpuset/camera-daemon/cpus 0-7
    write /dev/cpuset/camera-daemon/mems 0
    chown cameraserver cameraserver /dev/cpuset/camera-daemon
    chown cameraserver cameraserver /dev/cpuset/camera-daemon/tasks
    chmod 0660 /dev/cpuset/camera-daemon/tasks
#USB controller configuration
    setprop vendor.usb.rndis.func.name "gsi"
    setprop vendor.usb.rmnet.func.name "gsi"
    setprop vendor.usb.rmnet.inst.name "rmnet"
    setprop vendor.usb.dpl.inst.name "dpl"
    setprop vendor.usb.qdss.inst.name "qdss_mdm"
    setprop vendor.usb.controller a600000.dwc3
#Load WLAN driver
    insmod /vendor/lib/modules/qca_cld3_wlan.ko

    chown system camera /sys/class/leds/led:torch_0/brightness
    chown system camera /sys/class/leds/led:torch_1/brightness
    chown system camera /sys/class/leds/led:flash_0/brightness
    chown system camera /sys/class/leds/led:flash_1/brightness
    chown system camera /sys/class/leds/led:switch_0/brightness
    chown system camera /sys/class/leds/led:switch_1/brightness
    chown system camera /sys/class/leds/led:switch_2/brightness
    chmod 0664 /sys/class/leds/led:torch_0/brightness
    chmod 0664 /sys/class/leds/led:torch_1/brightness
    chmod 0664 /sys/class/leds/led:flash_0/brightness
    chmod 0664 /sys/class/leds/led:flash_1/brightness
    chmod 0664 /sys/class/leds/led:switch_0/brightness
    chmod 0664 /sys/class/leds/led:switch_1/brightness
    chmod 0664 /sys/class/leds/led:switch_2/brightness
    trigger setchargerprop

on setchargerprop
    #set qcom hvdcp_opti binary required properties for 7250
    setprop persist.vendor.cp.support_cc_mode 1
    setprop persist.vendor.chg.max_volt_mv 9500
    setprop persist.vendor.cp.ilim_offset_ua 400000
    setprop persist.vendor.cp.ilim_offset_pct 100
    setprop persist.vendor.cp.iadp_fcc_offset_ma 0
    setprop persist.vendor.cp.qc3_step_offset_ua 750000
# move this config to json file, to config diff for each prj
# setprop persist.vendor.cp.fcc_main_ua 800000

on property:vendor.display.lcd_density=560
   setprop dalvik.vm.heapgrowthlimit 256m

on property:vendor.display.lcd_density=640
   setprop dalvik.vm.heapgrowthlimit 512m

on boot && property:persist.vendor.usb.controller.default=*
    setprop vendor.usb.controller ${persist.vendor.usb.controller.default}

on property:vendor.usb.controller=*
    setprop sys.usb.controller ${vendor.usb.controller}

on charger
    start vendor.power_off_alarm
    setprop vendor.usb.controller a600000.dwc3
    setprop sys.usb.configfs 1
    trigger setchargerprop

#pd-mapper
service vendor.pd_mapper /vendor/bin/pd-mapper
    class core
    user system
    group system

#Peripheral manager
service vendor.per_mgr /vendor/bin/pm-service
    class core
    user system
    group system
    ioprio rt 4

service vendor.per_proxy /vendor/bin/pm-proxy
    class core
    user system
    group system
    disabled

service vendor.mdm_helper /vendor/bin/mdm_helper
    class core
    group system wakelock
    disabled

service vendor.mdm_launcher /vendor/bin/sh /vendor/bin/init.mdm.sh
    class core
    oneshot

on property:init.svc.vendor.per_mgr=running
    start vendor.per_proxy

on property:sys.shutdown.requested=*
    stop vendor.per_proxy

on property:vold.decrypt=trigger_restart_framework
   start vendor.cnss_diag

service vendor.cnss_diag /system/vendor/bin/cnss_diag -q -f -t HELIUM
   class main
   user system
   group system wifi inet sdcard_rw media_rw diag
   oneshot

service dcvs-sh /vendor/bin/init.qti.dcvs.sh
    class late_start
    user root
    group root system
    disabled
    oneshot

on property:vendor.dcvs.prop=1
   start dcvs-sh

on property:persist.sys.thermalNR.enable=1
   write /dev/kmsg thermal-Enable-start
   write /sys/class/thermal/${ro.5g.dl.zoneid}/mode disabled
   write /sys/class/thermal/${ro.5g.ul.zoneid}/mode disabled
   write /sys/class/thermal/${ro.5g.dl.zoneid}/trip_point_0_temp 52000
   write /sys/class/thermal/${ro.5g.dl.zoneid}/trip_point_1_temp 54000
   write /sys/class/thermal/${ro.5g.ul.zoneid}/trip_point_1_temp 61000
   write /sys/class/thermal/${ro.5g.ul.zoneid}/trip_point_0_temp 59000
   write /sys/class/thermal/${ro.5g.dl.zoneid}/mode enabled
   write /sys/class/thermal/${ro.5g.ul.zoneid}/mode enabled
   write /dev/kmsg thermal-Enable-end

on property:persist.sys.thermalNR.enable=0
   write /dev/kmsg thermal-Disable-start
   write /sys/class/thermal/${ro.5g.dl.zoneid}/mode disabled
   write /sys/class/thermal/${ro.5g.ul.zoneid}/mode disabled
   write /sys/class/thermal/${ro.5g.dl.zoneid}/trip_point_0_temp 100000
   write /sys/class/thermal/${ro.5g.dl.zoneid}/trip_point_1_temp 105000
   write /sys/class/thermal/${ro.5g.ul.zoneid}/trip_point_1_temp 110000
   write /sys/class/thermal/${ro.5g.ul.zoneid}/trip_point_0_temp 100000
   write /sys/class/thermal/${ro.5g.dl.zoneid}/mode enabled
   write /sys/class/thermal/${ro.5g.ul.zoneid}/mode enabled
   write /dev/kmsg thermal-Disable-end

#copy megvii files
on property:sys.boot_completed=1
    mkdir /data/vendor/camera/westalgo 0744 cameraserver audio
    mkdir /data/vendor/camera/westalgo/dof_model 0744 cameraserver audio
    mkdir /data/vendor/camera/westalgo/rtdof_model 0744 cameraserver audio
    mkdir /data/vendor/camera/westalgo/rtdof_model/mask 0744 cameraserver audio
    mkdir /data/vendor/camera/westalgo/rtdof_model/score 0744 cameraserver audio
    mkdir /data/vendor/camera/westalgo/rtdof_model/nn 0744 cameraserver audio
    copy /vendor/etc/camera/westalgo/dof_model/cache_data /data/vendor/camera/westalgo/dof_model/cache_data
    chown cameraserver audio  /data/vendor/camera/westalgo/dof_model/cache_data
    copy /vendor/etc/camera/westalgo/dof_model/segment_model /data/vendor/camera/westalgo/dof_model/segment_model
    chown cameraserver audio  /data/vendor/camera/westalgo/dof_model/segment_model
    copy /vendor/etc/camera/westalgo/dof_model/model_mdl_cache /data/vendor/camera/westalgo/dof_model/model_mdl_cache
    chown cameraserver audio  /data/vendor/camera/westalgo/dof_model/model_mdl_cache
    copy /vendor/etc/camera/westalgo/dof_model/capture_cache /data/vendor/camera/westalgo/dof_model/capture_cache
    chown cameraserver audio  /data/vendor/camera/westalgo/dof_model/capture_cache
    copy /vendor/etc/camera/westalgo/dof_model/capture_policy /data/vendor/camera/westalgo/dof_model/capture_policy
    chown cameraserver audio  /data/vendor/camera/westalgo/dof_model/capture_policy
    copy /vendor/etc/camera/westalgo/dof_model/capture_model /data/vendor/camera/westalgo/dof_model/capture_model
    chown cameraserver audio  /data/vendor/camera/westalgo/dof_model/capture_model
    copy /vendor/etc/camera/westalgo/rtdof_model/mask/cache_data /data/vendor/camera/westalgo/rtdof_model/mask/cache_data
    chown cameraserver audio  /data/vendor/camera/westalgo/rtdof_model/mask/cache_data
    chmod 0644 /data/vendor/camera/westalgo/rtdof_model/mask/cache_data
    copy /vendor/etc/camera/westalgo/rtdof_model/mask/segment_model /data/vendor/camera/westalgo/rtdof_model/mask/segment_model
    chown cameraserver audio  /data/vendor/camera/westalgo/rtdof_model/mask/segment_model
    chmod 0744 /data/vendor/camera/westalgo/rtdof_model/mask/segment_model
    copy /vendor/etc/camera/westalgo/rtdof_model/mask/model_mdl_cache /data/vendor/camera/westalgo/rtdof_model/mask/model_mdl_cache
    chown cameraserver audio  /data/vendor/camera/westalgo/rtdof_model/mask/model_mdl_cache
    chmod 0644 /data/vendor/camera/westalgo/rtdof_model/mask/model_mdl_cache
    copy /vendor/etc/camera/westalgo/rtdof_model/score/cache_data /data/vendor/camera/westalgo/rtdof_model/score/cache_data
    chown cameraserver audio  data/vendor/camera/westalgo/rtdof_model/score/cache_data
    chmod 0644 data/vendor/camera/westalgo/rtdof_model/score/cache_data
    copy /vendor/etc/camera/westalgo/rtdof_model/score/segment_model /data/vendor/camera/westalgo/rtdof_model/score/segment_model
    chown cameraserver audio  /data/vendor/camera/westalgo/rtdof_model/score/segment_model
    chmod 0744 /data/vendor/camera/westalgo/rtdof_model/score/segment_model
    copy /vendor/etc/camera/westalgo/rtdof_model/score/model_mdl_cache /data/vendor/camera/westalgo/rtdof_model/score/model_mdl_cache
    chown cameraserver audio  /data/vendor/camera/westalgo/rtdof_model/score/model_mdl_cache
    chmod 0644 /data/vendor/camera/westalgo/rtdof_model/score/model_mdl_cache
    copy /vendor/etc/camera/westalgo/rtdof_model/nn/cache_data /data/vendor/camera/westalgo/rtdof_model/nn/cache_data
    chown cameraserver audio  data/vendor/camera/westalgo/rtdof_model/nn/cache_data
    chmod 0644 data/vendor/camera/westalgo/rtdof_model/nn/cache_data
    copy /vendor/etc/camera/westalgo/rtdof_model/nn/segment_model /data/vendor/camera/westalgo/rtdof_model/nn/segment_model
    chown cameraserver audio  /data/vendor/camera/westalgo/rtdof_model/nn/segment_model
    chmod 0744 /data/vendor/camera/westalgo/rtdof_model/nn/segment_model
    copy /vendor/etc/camera/westalgo/rtdof_model/nn/model_mdl_cache /data/vendor/camera/westalgo/rtdof_model/nn/model_mdl_cache
    chown cameraserver audio  /data/vendor/camera/westalgo/rtdof_model/nn/model_mdl_cache
    chmod 0644 /data/vendor/camera/westalgo/rtdof_model/nn/model_mdl_cache
    copy /vendor/etc/camera/westalgo/rtdof_model/nn/preview_cache /data/vendor/camera/westalgo/rtdof_model/nn/preview_cache
    chown cameraserver audio  data/vendor/camera/westalgo/rtdof_model/nn/preview_cache
    chmod 0644 data/vendor/camera/westalgo/rtdof_model/nn/preview_cache
    copy /vendor/etc/camera/westalgo/rtdof_model/nn/preview_policy /data/vendor/camera/westalgo/rtdof_model/nn/preview_policy
    chown cameraserver audio  /data/vendor/camera/westalgo/rtdof_model/nn/preview_policy
    chmod 0744 /data/vendor/camera/westalgo/rtdof_model/nn/preview_policy
    copy /vendor/etc/camera/westalgo/rtdof_model/nn/preview_model /data/vendor/camera/westalgo/rtdof_model/nn/preview_model
    chown cameraserver audio  /data/vendor/camera/westalgo/rtdof_model/nn/preview_model
    chmod 0644 /data/vendor/camera/westalgo/rtdof_model/nn/preview_model
    mkdir /mnt/vendor/persist/camera 0744 system cameraserver
    chown system cameraserver /mnt/vendor/persist/camera/dualcam_cali.bin
    chmod 0644 /mnt/vendor/persist/camera/dualcam_cali.bin

on property:sys.power_saver_on=1
    write /sys/class/thermal/cooling_device0/cur_state 3
    write /sys/class/thermal/cooling_device1/cur_state 4
    write /sys/class/thermal/cooling_device2/cur_state 5
on property:sys.power_saver_on=0
    write /sys/class/thermal/cooling_device0/cur_state 0
    write /sys/class/thermal/cooling_device1/cur_state 0
    write /sys/class/thermal/cooling_device2/cur_state 0
